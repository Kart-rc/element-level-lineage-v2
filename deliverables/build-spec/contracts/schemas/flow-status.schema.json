{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.throughline.internal/collection/flow-status/1.0.0",
  "title": "Per-flow collection-status record",
  "x-source": [
    "deliverables/aws-lineage-collection-plan/08-scale-resilience-observability.md §5.3 (flow-status record, JSON example made normative)",
    "deliverables/aws-lineage-collection-plan/01-decision-records.md ADR-026 (correlation IDs, 'where is my run?')"
  ],
  "x-normativity": "Shape normative here. Storage: DynamoDB, TTL ~90 d; written at each stage transition (~5–7 writes/flow). Powers GET /v1/flows/{correlationId}/status (endpoint 29) and the Admin screen 7. Every flow gets a record — including no-impact exits.",
  "type": "object",
  "required": ["correlationId", "trigger", "lane", "stages", "outcome"],
  "properties": {
    "correlationId": { "type": "string", "description": "The originating trigger's envelope eventId (ULID)" },
    "trigger": {
      "type": "string",
      "enum": [
        "onboarding.registered", "repo.onboarded", "repo.inventory.delta", "repo.classified",
        "repo.push", "repo.pr.updated", "repo.pr.rebased", "repo.pr.merged",
        "deploy.succeeded", "deploy.failed", "deploy.rolledback",
        "schedule.nightly", "interaction.aggregation", "registry.changed",
        "collector.heartbeat-lost", "ttl.expiry-approaching", "toolchain.updated",
        "proposal.finalized", "test.run.completed"
      ]
    },
    "lane": { "type": "string", "enum": ["pr-gate", "deploy", "baseline-backfill", "incremental", "direct"], "description": "incremental = push path; direct = EventBridge-direct flows that use no SQS lane (e.g. proposal.finalized, collector.heartbeat-lost, ttl.expiry-approaching, interaction.aggregation) — see the event catalog's lane notes" },
    "app": { "type": "string", "description": "Populated for app-scoped flows" },
    "repo": { "type": "string", "description": "Populated for repo-scoped triggers (push, PR, onboarding, nightly per-repo); absent for app-, fleet-, or evidence-scoped flows such as interaction.aggregation, ttl.expiry-approaching, proposal.finalized" },
    "sha": { "type": "string" },
    "artifactDigest": { "type": "string" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "at"],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "received", "class-gated", "classified", "resolved", "extracted",
              "reconciled", "diffed", "decided", "rendered", "promoted",
              "published", "reported"
            ]
          },
          "at": { "type": "string", "format": "date-time" },
          "verdict": { "type": "string", "description": "e.g. impact-possible | no-impact | class:<class>" },
          "artifact": { "type": "string" },
          "edges": { "type": "integer", "minimum": 0 },
          "trust": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "outcome": { "type": "string", "enum": ["succeeded", "no-impact", "failed", "fail-open"] },
    "errorClass": {
      "type": ["string", "null"],
      "description": "Populated iff outcome=failed: the component's error taxonomy value (each component's LLD defines its taxonomy)"
    }
  }
}
